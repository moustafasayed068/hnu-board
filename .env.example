# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=
# "1" turns debug on; anything else (or unset) means production mode.
DJANGO_DEBUG=
# Comma-separated, no spaces. Local: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=
# Optional. 1 or 2: the semester whose courses students can pick.
# Leave empty to guess from the date (Sep-Jan = 1, Feb-Aug = 2).
DJANGO_CURRENT_SEMESTER=
# Optional. Shared secret for the WhatsApp bot. Empty = import switched off.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
# Optional. Telegram import: forward channel posts to your Telegram bot (see PLAN.md).
# Token from @BotFather. Secret: any random text, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs that may post (send the bot a message to see yours).
TELEGRAM_ALLOWED_USER_IDS=
# Optional. Level (1-4) for forwarded posts that don't mention one. Empty = shown on every level.
TELEGRAM_DEFAULT_LEVEL=
# Same Cohere key as whatsapp-bot/.env. Empty = simple regex parsing.
COHERE_API_KEY=
# Optional. Visitor stats with goatcounter.com (free, no cookies): your site code. Empty = off.
GOATCOUNTER_CODE=
