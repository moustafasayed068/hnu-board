# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=
# "1" turns debug on; anything else (or unset) means production mode.
DJANGO_DEBUG=
# Comma-separated, no spaces. Local: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=
# Optional. 1 or 2: the semester whose courses students can pick.
# Leave empty to guess from the date (Sep-Jan = 1, Feb-Aug = 2).
DJANGO_CURRENT_SEMESTER=
# Optional. Shared secret for the WhatsApp bot. Empty = import switched off.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
