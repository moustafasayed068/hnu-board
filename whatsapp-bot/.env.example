# Copy to .env and fill in. Never commit .env.

# Your site, and the same INGEST_TOKEN you set on PythonAnywhere.
SITE_URL=https://mosuatafa.pythonanywhere.com
INGEST_TOKEN=

# Channel ids, comma separated. Add =LEVEL only for a channel that posts for one level
# (used when a message doesn't say); without it, posts with no clear level go to every level.
# Get one with:  npm run find-channel -- "https://whatsapp.com/channel/XXXXXXXX"
# Example: CHANNELS=120363304638236808@newsletter,120363000000000000@newsletter=3
CHANNELS=

# Free key from https://dashboard.cohere.com/api-keys
# Without it, every message becomes an announcement; its level comes from "Level N" / "الفرقة ..." in the text.
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
