# Copy to .env and fill in. Never commit .env.

# Your site, and the same INGEST_TOKEN you set on PythonAnywhere.
SITE_URL=https://mosuatafa.pythonanywhere.com
INGEST_TOKEN=

# Channel JIDs, comma separated. Get one with:
#   npm run find-channel -- https://whatsapp.com/channel/XXXXXXXX
CHANNELS=

# Free key from https://dashboard.cohere.com/api-keys
# Without it, every message becomes an announcement and needs "Level N" in its text.
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
